---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const siteDomain = 'https://jichangtuijian.site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    ...(item.url ? { item: `${siteDomain}${item.url.startsWith('/') ? item.url : `/${item.url}`}` } : {})
  }))
};
---

<nav aria-label="面包屑导航" class="my-4 text-sm text-slate-500">
  <ol class="flex flex-wrap items-center space-x-2">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center space-x-2">
          {index > 0 && (
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          )}
          {isLast || !item.url ? (
            <span class="font-medium text-slate-800" aria-current="page">{item.name}</span>
          ) : (
            <a href={item.url} class="hover:text-brand-600 transition-colors underline-offset-2 hover:underline">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
