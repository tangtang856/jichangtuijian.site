---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  modifyDate?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  publishDate,
  modifyDate,
  noindex = false,
  schema,
} = Astro.props;

const siteDomain = 'https://jichangtuijian.site';

// 确保使用标准统一的绝对 URL
const canonicalUrl = canonical 
  ? (canonical.startsWith('http') ? canonical : `${siteDomain}${canonical}`)
  : `${siteDomain}${Astro.url.pathname}`;

// 规范化结尾斜杠（除包含后缀的文件外）
const normalizedCanonical = canonicalUrl.endsWith('/') || canonicalUrl.includes('.') 
  ? canonicalUrl 
  : `${canonicalUrl}/`;

const ogImage = `${siteDomain}/og-image.png`;

// 全站基础 WebSite 和 Organization Schema
const defaultSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteDomain}/#website`,
    url: siteDomain,
    name: '机场推荐指南 (JiChangTuiJian.site)',
    description: '专业中文科学上网机场与梯子节点测评、性价比排行与网络配置百科',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteDomain}/#organization`,
    name: '机场推荐评测实验室',
    url: siteDomain,
    logo: `${siteDomain}/favicon.svg`,
    sameAs: ['https://github.com/tangtang856/jichangtuijian.site']
  }
];

const finalSchemas = schema 
  ? (Array.isArray(schema) ? [...defaultSchemas, ...schema] : [...defaultSchemas, schema])
  : defaultSchemas;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={normalizedCanonical} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={normalizedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="机场推荐网 - 梯子节点与科学上网评测" />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={ogImage} />
{publishDate && <meta property="article:published_time" content={publishDate} />}
{modifyDate && <meta property="article:modified_time" content={modifyDate} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured Data / JSON-LD -->
{finalSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
