<script>
  // Mobile Menu Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Desktop Contact Popover Toggle
  const contactWrapper = document.getElementById('contact-menu-wrapper');
  const contactBtn = document.getElementById('contact-menu-btn');
  const contactPopover = document.getElementById('contact-popover');
  const contactChevron = document.getElementById('contact-chevron');

  function toggleContactPopover(force?: boolean) {
    if (!contactPopover) return;
    const isHidden = contactPopover.classList.contains('hidden');
    const shouldShow = force !== undefined ? force : isHidden;

    if (shouldShow) {
      contactPopover.classList.remove('hidden');
      contactBtn?.setAttribute('aria-expanded', 'true');
      contactChevron?.classList.add('rotate-180');
    } else {
      contactPopover.classList.add('hidden');
      contactBtn?.setAttribute('aria-expanded', 'false');
      contactChevron?.classList.remove('rotate-180');
    }
  }

  if (contactBtn) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleContactPopover();
    });
  }

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (contactWrapper && !contactWrapper.contains(e.target as Node)) {
      toggleContactPopover(false);
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggleContactPopover(false);
    }
  });

  // Universal Copy-to-Clipboard Functionality
  function setupCopyButtons() {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn[data-copy]');
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const textToCopy = btn.getAttribute('data-copy');
        if (!textToCopy) return;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(textToCopy);
          } else {
            // Fallback for older browsers/contexts
            const textarea = document.createElement('textarea');
            textarea.value = textToCopy;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }

          const label = btn.querySelector('.copy-text');
          const originalText = label ? label.textContent : btn.textContent;
          if (label) {
            label.textContent = '已复制 ✓';
          }
          btn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');

          setTimeout(() => {
            if (label) {
              label.textContent = originalText;
            }
            btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    });
  }

  // Initialize copy handlers on load
  setupCopyButtons();
</script>
