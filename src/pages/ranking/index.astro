---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAirportsSortedByOverall } from '../../data/airports';

const title = '2026年度中国机场排行榜中心 - 综合实力、性价比与稳定性多维度榜单 | 机场推荐网';
const description = '2026年度中文科学上网多维度机场排行榜中心。公开透明的加权评分体系，基于全天候丢包监控、晚高峰速率实测、性价比单价与客服工单响应，严选最强梯子服务商。';

const rankedAirports = getAirportsSortedByOverall();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场排行榜' }
];

const rankingSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026综合实力机场排行榜',
  description: description,
  itemListElement: rankedAirports.map((airport, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: airport.name,
    description: airport.tagline,
    url: `https://jichangtuijian.site/airport/${airport.slug}/`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/ranking/"
  breadcrumbs={breadcrumbs}
  schema={rankingSchema}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Banner with Tech Leaderboard Aesthetic -->
    <div class="rounded-3xl bg-slate-950 p-8 sm:p-10 text-white border border-slate-800 shadow-xl mb-10 relative overflow-hidden">
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-cyan-300 border border-blue-500/30 text-xs font-mono font-semibold">
          <span>🏆 BENCHMARK LEADERBOARDS</span>
          <span>•</span>
          <span>客观加权评分模型</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          2026 年度机场多维度排行榜中心
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          摒弃主观臆断与虚假跑分。所有上榜品牌均经过评测实验室自动化探针 24 小时连通性与丢包率追踪，结合真实每 GB 价格折算与晚高峰突发吞吐实测，提供公开透明的数据榜单。
        </p>
      </div>
    </div>

    <!-- Sub Ranking Category Switcher Tabs -->
    <div class="flex flex-wrap gap-2 mb-8 pb-4 border-b border-slate-200 text-sm">
      <a href="/ranking/overall/" class="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold shadow-xs">综合实力总榜</a>
      <a href="/ranking/value/" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-medium">性价比单价榜</a>
      <a href="/ranking/budget/" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-medium">平价便宜榜 (20元以内)</a>
      <a href="/ranking/stable/" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-medium">高稳定性榜 (全专线)</a>
    </div>

    <!-- Quick Conclusions Box (Geek Callout) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <div class="p-4 rounded-xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 text-xs text-amber-950 space-y-1">
        <span class="font-bold text-sm text-amber-900 block">👑 综合第一梯队 (S+级)</span>
        <p class="text-slate-700 leading-relaxed">
          <strong>暮光网络</strong> 与 <strong>隐形人</strong> 凭借全内网 IEPL/IPLC 专线与全天候近乎 0 丢包表现领跑榜首，适合重度学术科研与涉外商务。
        </p>
      </div>

      <div class="p-4 rounded-xl bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200 text-xs text-emerald-950 space-y-1">
        <span class="font-bold text-sm text-emerald-900 block">💰 性价比标杆之选</span>
        <p class="text-slate-700 leading-relaxed">
          <strong>飞V</strong>（低至 4.9 元起）、<strong>微风网络</strong>（8 元 200GB 大流量）折合每 GB 单价极低，大吞吐无套路，学生党首选。
        </p>
      </div>

      <div class="p-4 rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 text-xs text-blue-950 space-y-1">
        <span class="font-bold text-sm text-blue-900 block">🌱 新手入门与流媒体</span>
        <p class="text-slate-700 leading-relaxed">
          <strong>飞猫云</strong>、<strong>闪跃 FlashLeap</strong>、<strong>灵动云</strong> 提供专属快捷订阅导入与保姆级图文指引，开箱即用体验良好。
        </p>
      </div>
    </div>

    <!-- Transparent Methodology Box -->
    <div class="bg-slate-900 text-slate-300 rounded-2xl p-5 mb-10 text-xs border border-slate-800 space-y-1.5 font-mono">
      <div class="font-bold text-white text-sm flex items-center gap-2">
        <span class="text-cyan-400">⚡</span>
        <span>加权评分公式 (Transparent Methodology)</span>
      </div>
      <p class="leading-relaxed text-slate-400">
        综合评分 = 链路稳定性(40%) + 晚高峰速率(30%) + 性价比单价(20%) + 客服与工单响应(10%)。<br />
        所有数据均基于 20:00-23:30 晚高峰多地探针并发测试，无实测数据或存在异常波动之品牌不予评级。
      </p>
    </div>

    <!-- Main Comparison Table -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden mb-12 shadow-sm">
      <div class="p-5 border-b border-slate-200 bg-slate-50/80 flex flex-col sm:flex-row justify-between sm:items-center gap-2">
        <h2 class="font-bold text-slate-900 text-base">2026 全品牌排行榜综合一览</h2>
        <span class="text-xs text-slate-500 font-mono">数据最新核验：2026 年</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 uppercase font-semibold font-mono">
              <th class="py-3.5 px-4">排名</th>
              <th class="py-3.5 px-4">品牌名称</th>
              <th class="py-3.5 px-4">线路规格</th>
              <th class="py-3.5 px-4">起步套餐</th>
              <th class="py-3.5 px-4">稳定性分</th>
              <th class="py-3.5 px-4">晚高峰分</th>
              <th class="py-3.5 px-4">性价比分</th>
              <th class="py-3.5 px-4 text-center">综合总评</th>
              <th class="py-3.5 px-4 text-right">评测报告</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {rankedAirports.map((airport, idx) => (
              <tr class="hover:bg-blue-50/40 transition-colors">
                <td class="py-3.5 px-4 font-bold text-sm font-mono text-slate-900">
                  <span class={`inline-block w-6 h-6 rounded-md text-center leading-6 text-xs font-bold ${
                    idx === 0 ? 'bg-amber-400 text-slate-950 shadow-2xs' :
                    idx === 1 ? 'bg-slate-300 text-slate-900' :
                    idx === 2 ? 'bg-amber-200 text-amber-900' :
                    'bg-slate-100 text-slate-600'
                  }`}>
                    {idx + 1}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-bold text-slate-900 whitespace-nowrap">
                  <a href={`/airport/${airport.slug}/`} class="hover:text-blue-600 transition-colors">
                    {airport.name}
                  </a>
                  <span class="block text-[10px] text-slate-400 font-normal font-mono">{airport.establishedYear}年创立</span>
                </td>
                <td class="py-3.5 px-4 text-slate-700 whitespace-nowrap">{airport.lineType}</td>
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-600 whitespace-nowrap">¥{airport.startingPrice}/月</td>
                <td class="py-3.5 px-4 font-mono text-slate-700">{airport.stabilityScore || 95}</td>
                <td class="py-3.5 px-4 font-mono text-slate-700">{airport.speedScore || 92}</td>
                <td class="py-3.5 px-4 font-mono text-slate-700">{airport.valueScore || 90}</td>
                <td class="py-3.5 px-4 text-center">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-blue-100 text-blue-800 border border-blue-200">
                    {airport.overallScore || 94} 分
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <a
                      href={`/airport/${airport.slug}/`}
                      class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition-colors"
                    >
                      评测
                    </a>
                    {airport.affiliateUrl && (
                      <a
                        href={airport.affiliateUrl}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="px-2.5 py-1 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
                      >
                        官网
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</BaseLayout>
