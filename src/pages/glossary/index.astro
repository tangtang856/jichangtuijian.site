---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = '网络知识与翻墙术语百科大全 | 机场推荐网';
const description = '科学上网、网络代理与机场专业术语知识百科。科普IPLC专线、BGP中转、规则分流、TUN模式、TLS混淆与流量倍率机制，扫清一切技术盲区。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '知识百科' }
];

const allTerms = await getCollection('glossary');
const sortedTerms = allTerms.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/glossary/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Header -->
    <div class="rounded-3xl bg-slate-950 p-8 sm:p-10 text-white border border-slate-800 shadow-xl mb-12 relative overflow-hidden">
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-semibold">
          <span>📖 GLOSSARY ENCYCLOPEDIA</span>
          <span>•</span>
          <span>技术原理透彻解析</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          网络知识与翻墙术语百科大全
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          告别行业黑话与虚假营销概念。我们整理了关于网络代理、加密协议、物理线路与客户端分流的核心专有名词，带你彻底理解背后的技术机制与底层逻辑。
        </p>
      </div>
    </div>

    <!-- Terms Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {sortedTerms.map((term) => (
        <a
          href={`/glossary/${term.slug}/`}
          class="rounded-2xl bg-white p-6 border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all group flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono font-semibold">
                {term.data.category}
              </span>
              <span class="text-slate-400 font-mono text-[11px]">{term.data.publishDate}</span>
            </div>

            <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
              {term.data.term}
            </h2>

            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
              {term.data.description}
            </p>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-600">
            <span>阅读完整词条定义</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
