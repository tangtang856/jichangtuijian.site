---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '隐私保护政策 | 机场推荐网';
const description = '机场推荐指南 (jichangtuijian.site) 隐私保护政策。说明本站无用户追踪、无用户注册数据库、极简日志与Cookies使用规范。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '隐私政策' }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/privacy-policy/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-3xl mx-auto bg-white rounded-xl border border-slate-200 p-6 sm:p-10 shadow-xs prose-content">
      
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">隐私保护政策</h1>
      <p class="text-sm text-slate-500 -mt-2">生效日期：2026年3月24日</p>

      <h2>一、我们的隐私承诺</h2>
      <p>
        <strong>机场推荐指南（jichangtuijian.site）</strong> 坚决尊重并保护每一位访问者的个人隐私。由于本站为纯静态资讯门户，我们**不提供任何用户注册功能，不设立任何个人身份信息数据库**。
      </p>

      <h2>二、数据收集与使用说明</h2>
      <ol>
        <li><strong>浏览日志：</strong> 当您访问本站时，托管服务商（如 Cloudflare Pages）可能会自动记录基础的网络请求日志（如您的 IP 地址、浏览器 User-Agent、请求页面 URL 及时间戳）。此类日志仅用于防御 DDoS 攻击、防止恶意爬虫及网络故障诊断，不会用于识别个人身份。</li>
        <li><strong>Cookie 使用：</strong> 本站默认不设置任何用于跨站商业广告追踪的第三方 Cookie。部分交互工具（如横向对比工具的选择记忆）仅存储在您的本地浏览器 LocalStorage 中，不会上传至任何云端服务器。</li>
        <li><strong>外链跳转：</strong> 当您点击本站中的外部第三方链接（如各机场官网或客户端 GitHub 仓库）离开本站时，您的网络行为受该目标网站自身的隐私政策管辖。</li>
      </ol>

      <h2>三、数据安全与未成年人保护</h2>
      <p>
        全站强制启用现代化 HTTPS / TLS 1.3 高强度加密传输，确保您在浏览过程中的通信链路免遭局域网中间人窃听。本站不面向未成年人收集任何信息。
      </p>

      <h2>四、政策变更与咨询</h2>
      <p>
        若本隐私政策有任何调整，将直接在本页面更新。如果您对隐私规范有任何疑问，请查阅 <a href="/contact/">联系方式</a>。
      </p>

    </div>
  </div>
</BaseLayout>
