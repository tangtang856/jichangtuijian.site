---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = '科学上网深度技术文章与选购科普指南 | 机场推荐网';
const description = '机场评测实验室深度技术文章专栏。汇集VPN与机场区别对比、翻墙代理协议深度剖析、IPLC专线架构揭秘、ChatGPT AI分流排查与4K流媒体解锁教程。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '博客文章' }
];

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/blog/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-3xl mb-10">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Deep Dives</span>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">深度技术与选购科普文章</h1>
      <p class="text-base text-slate-600 mt-3 leading-relaxed">
        由评测实验室工程师撰写的深度长文。拒绝虚假营销与浮夸宣传，以严谨的技术视角剖析底层协议、线路拓扑、网络风控与隐私安全。
      </p>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {sortedPosts.map((post) => (
        <article class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 hover:border-brand-500 hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
              <span class="px-2.5 py-0.5 rounded bg-blue-50 text-brand-700 font-semibold border border-blue-100">
                {post.data.category}
              </span>
              <time class="font-mono">{post.data.publishDate}</time>
            </div>

            <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>

            <p class="text-xs sm:text-sm text-slate-600 mt-3 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="text-slate-500 bg-slate-100 px-2 py-0.5 rounded text-[11px]">#{tag}</span>
              ))}
            </div>
            <a href={`/blog/${post.slug}/`} class="font-semibold text-brand-600 hover:text-brand-800 flex items-center gap-1">
              阅读全文 →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
