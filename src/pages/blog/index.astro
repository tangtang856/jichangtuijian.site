---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = '科学上网深度技术文章与选购科普指南 (200+篇精选文章) | 机场推荐指南';
const description = '机场评测实验室深度长文专栏。涵盖翻墙协议深度对比、IPLC专线拓扑揭秘、流媒体4K解锁、ChatGPT/Claude AI分流排查、办公开发加速与节点地区特性等200余篇专业原创文章。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '博客文章' }
];

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const categories = [
  '全部',
  '协议技术',
  '选购指南',
  '线路解析',
  '流媒体解锁',
  'AI智能工具',
  '办公与开发',
  '故障排查',
  '地区节点'
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/blog/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Articles Archive ({sortedPosts.length} 篇)</span>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">深度技术与选购科普文章中心</h1>
      <p class="text-base text-slate-600 mt-3 leading-relaxed">
        由评测实验室工程师撰写的系统化专栏。拒绝虚假营销与空洞总结，以严谨的技术视角剖析底层协议、线路拓扑、网络风控与隐私安全，全方位解答你的科学上网疑惑。
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex flex-wrap gap-2 mb-8 pb-4 border-b border-slate-200 text-xs sm:text-sm font-medium" id="category-filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-cat={cat}
          class={`px-3.5 py-1.5 rounded-lg border transition-all ${
            idx === 0
              ? 'bg-brand-600 text-white border-brand-600 shadow-xs active-cat'
              : 'bg-white text-slate-700 border-slate-200 hover:border-brand-300 hover:bg-slate-50'
          }`}
        >
          {cat} {cat === '全部' ? `(${sortedPosts.length})` : ''}
        </button>
      ))}
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16" id="articles-container">
      {sortedPosts.map((post) => (
        <article
          data-category={post.data.category}
          class="article-card bg-white rounded-xl border border-slate-200 p-6 hover:border-brand-500 hover:shadow-md transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between text-[11px] text-slate-500 mb-2.5">
              <span class="px-2 py-0.5 rounded bg-blue-50 text-brand-700 font-semibold border border-blue-100">
                {post.data.category}
              </span>
              <time class="font-mono">{post.data.publishDate}</time>
            </div>

            <h2 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>

            <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <div class="flex flex-wrap gap-1">
              {post.data.tags.slice(0, 2).map(tag => (
                <span class="text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded text-[10px]">#{tag}</span>
              ))}
            </div>
            <a href={`/blog/${post.slug}/`} class="font-semibold text-brand-600 hover:text-brand-800 flex items-center gap-0.5">
              阅读全文 →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll('#category-filters button');
  const cards = document.querySelectorAll('.article-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-cat');

      filterButtons.forEach(b => {
        b.className = 'px-3.5 py-1.5 rounded-lg border transition-all bg-white text-slate-700 border-slate-200 hover:border-brand-300 hover:bg-slate-50';
      });
      btn.className = 'px-3.5 py-1.5 rounded-lg border transition-all bg-brand-600 text-white border-brand-600 shadow-xs active-cat';

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (selected === '全部' || cardCat === selected) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
