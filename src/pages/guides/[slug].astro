---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

export interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content } = await guide.render();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '教程中心', url: '/guides/' },
  { name: guide.data.title }
];

const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishDate,
  dateModified: guide.data.modifyDate || guide.data.publishDate,
  author: {
    '@type': 'Organization',
    name: '机场评测实验室'
  },
  publisher: {
    '@type': 'Organization',
    name: '机场推荐指南',
    url: 'https://jichangtuijian.site'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://jichangtuijian.site/guides/${guide.slug}/`
  }
};
---

<BaseLayout
  title={`${guide.data.title} | 机场推荐指南`}
  description={guide.data.description}
  canonical={`https://jichangtuijian.site/guides/${guide.slug}/`}
  type="article"
  publishDate={guide.data.publishDate}
  modifyDate={guide.data.modifyDate}
  breadcrumbs={breadcrumbs}
  schema={guideSchema}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Main Guide Article -->
      <article class="lg:col-span-3 bg-white rounded-xl border border-slate-200 p-6 sm:p-10 shadow-xs">
        
        <header class="border-b border-slate-100 pb-6 mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
            <span class="px-2.5 py-0.5 rounded bg-emerald-50 text-emerald-800 font-bold border border-emerald-200">
              {guide.data.platform} 平台
            </span>
            <span class="text-slate-400">·</span>
            <time class="text-slate-500 font-mono">发布时间：{guide.data.publishDate}</time>
            {guide.data.modifyDate && (
              <>
                <span class="text-slate-400">·</span>
                <span class="text-brand-600 font-mono">更新时间：{guide.data.modifyDate}</span>
              </>
            )}
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {guide.data.title}
          </h1>

          <p class="text-xs sm:text-sm text-slate-600 mt-4 leading-relaxed bg-slate-50 p-4 rounded-lg border-l-4 border-emerald-500">
            <strong>教程摘要：</strong>{guide.data.description}
          </p>

          {guide.data.clientApps.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center gap-1.5 text-xs">
              <span class="text-slate-500 font-medium">适用客户端：</span>
              {guide.data.clientApps.map((app) => (
                <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-mono">
                  {app}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose-content max-w-article mx-auto">
          <Content />
        </div>

        <footer class="mt-12 pt-6 border-t border-slate-200 text-xs flex flex-wrap items-center justify-between gap-4">
          <div class="text-slate-500">
            教程维护：<span class="font-medium text-slate-800">机场评测实验室技术组</span>
          </div>
          <div class="flex gap-3">
            <a href="/guides/" class="text-brand-600 hover:underline">← 返回教程中心目录</a>
            <a href="/recommend/" class="text-emerald-700 font-semibold hover:underline">浏览推荐机场专区 →</a>
          </div>
        </footer>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-6">
        
        <!-- Platform Navigation -->
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs text-xs">
          <h3 class="font-bold text-slate-900 text-sm mb-3">📱 平台专属指引</h3>
          <ul class="space-y-2">
            <li><a href="/guides/windows/" class="text-slate-700 hover:text-brand-600 font-medium block">→ Windows 配置专区</a></li>
            <li><a href="/guides/android/" class="text-slate-700 hover:text-brand-600 font-medium block">→ Android 安卓配置专区</a></li>
            <li><a href="/guides/ios/" class="text-slate-700 hover:text-brand-600 font-medium block">→ iOS 小火箭/圈叉专区</a></li>
            <li><a href="/guides/macos/" class="text-slate-700 hover:text-brand-600 font-medium block">→ macOS 苹果电脑专区</a></li>
          </ul>
        </div>

        <!-- Quick Airport Pick -->
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs text-xs">
          <h3 class="font-bold text-slate-900 text-sm mb-3">⚡ 优质节点直达</h3>
          <p class="text-slate-500 mb-3">配置客户端前，需先备好稳定可靠的节点订阅：</p>
          <ul class="space-y-2 font-medium">
            <li><a href="/recommend/budget/" class="text-emerald-700 hover:underline">→ 高性价比便宜机场精选</a></li>
            <li><a href="/recommend/premium/" class="text-brand-600 hover:underline">→ 晚高峰 IPLC 专线推荐</a></li>
            <li><a href="/ranking/overall/" class="text-slate-800 hover:underline">→ 2026 综合实力排行榜</a></li>
            <li><a href="/compare/" class="text-indigo-600 hover:underline">→ 多款机场在线参数对比</a></li>
          </ul>
        </div>

      </aside>

    </div>
  </div>
</BaseLayout>
