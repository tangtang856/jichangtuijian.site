---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = '科学上网客户端配置与翻墙节点使用教程中心 (30篇精选教程) | 机场推荐指南';
const description = '2026全平台科学上网保姆级教程中心。涵盖Windows、Android、iOS（小火箭/Loon/圈叉）、macOS、软路由OpenWrt与进阶分流优化共30篇系统图文指引。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '教程中心' }
];

const platforms = [
  {
    title: 'Windows 系统',
    slug: 'windows',
    icon: '💻',
    color: 'blue',
    apps: ['Clash Verge Rev', 'Sing-box', 'v2rayN'],
    desc: '推荐开源无广告的 Clash Verge Rev。支持 TUN 虚拟网卡接管、智能分流、延迟优选测速与一键订阅导入。',
    href: '/guides/windows/'
  },
  {
    title: 'Android 安卓',
    slug: 'android',
    icon: '📱',
    color: 'emerald',
    apps: ['Clash Verge Android', 'v2rayNG', 'Sing-box'],
    desc: '安卓平台客户端安装 APK、订阅一键导入、开启省电模式白名单与开机自启后台常驻保活设置。',
    href: '/guides/android/'
  },
  {
    title: 'iOS 苹果系统',
    slug: 'ios',
    icon: '🍎',
    color: 'indigo',
    apps: ['Shadowrocket (小火箭)', 'Loon', 'Surge', '圈叉'],
    desc: '外区 Apple ID 获取方法、App Store 正版下载、扫码秒导订阅与按需连接 (On-Demand) 优化。',
    href: '/guides/ios/'
  },
  {
    title: 'macOS 苹果电脑',
    slug: 'macos',
    icon: '🖥️',
    color: 'purple',
    apps: ['Clash Verge Mac', 'Surge Mac', '终端代理'],
    desc: 'Mac 用户系统代理授权、终端命令行 Terminal 代理加速、M芯片优化与 Surge 网关分流。',
    href: '/guides/macos/'
  }
];

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const platformGroups = [
  { name: 'Windows 专属教程', platform: 'Windows', icon: '💻' },
  { name: 'Android 安卓教程', platform: 'Android', icon: '📱' },
  { name: 'iOS 苹果客户端教程', platform: 'iOS', icon: '🍎' },
  { name: 'macOS 苹果电脑教程', platform: 'macOS', icon: '🖥️' },
  { name: '软路由与家庭网关', platform: 'Router', icon: '📡' },
  { name: '高阶网络与分流技巧', platform: 'General', icon: '⚙️' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jichangtuijian.site/guides/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Header with Geek Hub Aesthetic -->
    <div class="rounded-3xl bg-slate-950 p-8 sm:p-10 text-white border border-slate-800 shadow-xl mb-12 relative overflow-hidden">
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-semibold">
          <span>📚 {allGuides.length} FULL TUTORIALS</span>
          <span>•</span>
          <span>全平台零门槛上手</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          全平台客户端配置与节点使用教程中心
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          涵盖 Windows、Android、iOS、macOS、软路由及高阶订阅转换共 30 篇保姆级指引。拒绝模棱两可的代码指令，手把手带你完成订阅一键导入、TUN 虚拟网卡配置与常见网络断流自愈排查。
        </p>
      </div>
    </div>

    <!-- 4 Major Platform Pillar Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {platforms.map(p => (
        <a
          href={p.href}
          class="bg-white p-6 rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-2 rounded-xl bg-slate-50 border border-slate-100">{p.icon}</span>
              <span class="text-[11px] font-semibold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-200">
                专属专区
              </span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
              {p.title}
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">
              {p.desc}
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-100 text-xs font-semibold text-blue-600 flex items-center justify-between">
            <span>浏览系统教程专栏</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Grouped Platform Tutorials (5 guides per group) -->
    <div class="space-y-14">
      {platformGroups.map((group) => {
        const groupGuides = sortedGuides.filter(g => g.data.platform === group.platform);
        if (groupGuides.length === 0) return null;

        return (
          <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-200">
              <div class="flex items-center gap-3">
                <span class="text-2xl p-2 rounded-lg bg-slate-100">{group.icon}</span>
                <div>
                  <h3 class="text-xl font-bold text-slate-900">{group.name}</h3>
                  <p class="text-xs text-slate-500 mt-0.5">该分类下收录 {groupGuides.length} 篇实操文档</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {groupGuides.map((guide) => (
                <a
                  href={`/guides/${guide.slug}/`}
                  class="p-5 rounded-xl border border-slate-200/80 hover:border-blue-400 hover:shadow-xs transition-all bg-slate-50/40 flex flex-col justify-between group"
                >
                  <div class="space-y-2">
                    <div class="flex items-center justify-between text-[11px]">
                      <span class="font-mono text-blue-600 font-semibold bg-blue-50 px-2 py-0.5 rounded">
                        {guide.data.difficulty || '入门必读'}
                      </span>
                      <span class="text-slate-400 font-mono">⏱️ {guide.data.readTime || '8 min'}</span>
                    </div>

                    <h4 class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition-colors leading-snug">
                      {guide.data.title}
                    </h4>

                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                      {guide.data.description}
                    </p>
                  </div>

                  <div class="pt-4 mt-3 border-t border-slate-200/60 flex items-center justify-between text-xs text-slate-600 group-hover:text-blue-600 font-medium">
                    <span>阅读详细配置图文</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

  </div>
</BaseLayout>
