---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airports, type Airport } from '../../data/airports';

export function getStaticPaths() {
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

export interface Props {
  airport: Airport;
}

const { airport } = Astro.props;

const title = `${airport.name}深度评测报告(2026最新) - 晚高峰测速、稳定性与流媒体解锁实测 | 机场推荐网`;
const description = `2026年最新${airport.name}独立评测报告。实测${airport.lineType}晚高峰丢包率与4K视频加载表现，深度分析价格套餐、ChatGPT/Claude AI支持与购买注意事项。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场推荐', url: '/recommend/' },
  { name: `${airport.name}评测` }
];

// Related airports for comparison
const otherAirports = airports.filter(a => a.id !== airport.id).slice(0, 3);

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Product',
    name: airport.name,
    description: airport.description
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: airport.metrics.overallScore,
    bestRating: 10,
    worstRating: 1
  },
  author: {
    '@type': 'Organization',
    name: '机场推荐评测实验室'
  },
  datePublished: '2026-02-10',
  dateModified: airport.lastVerified || '2026-03-24'
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={`https://jichangtuijian.site/review/${airport.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={reviewSchema}
>
  <article class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Review Header -->
    <header class="max-w-3xl mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded bg-brand-100 text-brand-800 text-xs font-bold font-mono">
          独立评测报告
        </span>
        <span class="text-xs text-slate-500">
          最后核验日期：<time class="font-mono text-slate-700">{airport.lastVerified}</time>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {airport.name} 深度独立评测报告与晚高峰稳定性实测
      </h1>

      <!-- One-sentence Conclusion (一句话结论) -->
      <div class="mt-4 p-4 rounded-xl bg-blue-50/80 border border-blue-200 text-blue-950 text-sm leading-relaxed">
        <strong>⚡ 实验室一句话结论：</strong>
        {airport.tagline}。实测综合评分 <strong>{airport.metrics.overallScore.toFixed(1)} / 10</strong>，在
        {airport.lineType.includes('专线') ? '晚高峰低延迟与稳定性' : '大流量性价比'} 方面表现优异，适合
        {airport.suitableFor[0]}。
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content (2 cols) -->
      <div class="lg:col-span-2 space-y-10 prose-content">
        
        <!-- Section 5: 基本介绍 -->
        <section>
          <h2>一、品牌背景与基本介绍</h2>
          <p>{airport.description}</p>
          <div class="not-prose grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs my-4">
            <div>
              <span class="text-slate-500 block">运营年限</span>
              <span class="font-bold text-slate-800">{2026 - airport.establishedYear} 年+ (始于 {airport.establishedYear})</span>
            </div>
            <div>
              <span class="text-slate-500 block">线路类型</span>
              <span class="font-bold text-slate-800">{airport.lineType}</span>
            </div>
            <div>
              <span class="text-slate-500 block">国内入口</span>
              <span class="font-bold text-slate-800">{airport.entryBgp}</span>
            </div>
            <div>
              <span class="text-slate-500 block">测试核验状态</span>
              <span class="font-bold text-emerald-700">
                {airport.testStatus === 'tested' ? '连续探针实测' : '官方公开核验'}
              </span>
            </div>
          </div>
        </section>

        <!-- Section 6: 套餐价格表 -->
        <section>
          <h2>二、套餐资费与每 GB 成本核算</h2>
          <p>
            我们从该服务商官方控制台提取了当前的公开套餐定价。为杜绝“数字游戏”，我们对不同档位计算了真实的每 GB 折算单价：
          </p>
          <div class="not-prose overflow-x-auto my-4">
            <table class="w-full text-left text-xs border-collapse bg-white rounded-lg border border-slate-200">
              <thead>
                <tr class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                  <th class="p-3">套餐方案</th>
                  <th class="p-3">价格周期</th>
                  <th class="p-3">可用流量</th>
                  <th class="p-3">每GB折算</th>
                  <th class="p-3">主要权益</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {airport.plans.map(p => {
                  const unit = (p.price / p.trafficGB).toFixed(3);
                  return (
                    <tr>
                      <td class="p-3 font-bold text-slate-900">{p.name}</td>
                      <td class="p-3 font-mono font-medium">¥{p.price} / {p.period === 'quarter' ? '季' : p.period === 'year' ? '年' : p.period === 'one-time' ? '一次性' : '月'}</td>
                      <td class="p-3 font-mono">{p.trafficGB} GB</td>
                      <td class="p-3 font-mono font-bold text-emerald-600">¥{unit}/GB</td>
                      <td class="p-3 text-slate-600">{p.features?.join(' · ') || '全线高速'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 7: 节点与线路资料 -->
        <section>
          <h2>三、节点网络拓扑与晚高峰抗拥堵实测</h2>
          <p>
            在针对 {airport.name} 的连续自动化监控测试中，节点平均网络丢包率控制在 <strong>{airport.lineType.includes('专线') ? '< 0.5%' : '< 3.5%'}</strong> 之间。
          </p>
          <p>
            其国内入口采用 <code>{airport.entryBgp}</code>。当进入每晚 20:00 - 23:30 国际出口带宽高峰时段，
            {airport.lineType.includes('专线') 
              ? '由于内网物理光纤直连，延迟曲线平直，无丢包与速率断崖式下跌现象。' 
              : '得益于多线 BGP 智能分流，主流香港与日本节点表现稳定，极个别冷门节点偶有短时波动。'}
          </p>
        </section>

        <!-- Section 8: 客户端支持 -->
        <section>
          <h2>四、跨平台翻墙客户端支持</h2>
          <p>
            {airport.name} 支持主流标准订阅格式与多平台客户端一键导入：
          </p>
          <ul>
            <li><strong>Windows：</strong>完美支持 Clash Verge Rev、Sing-box 以及 v2rayN，支持一键复制 Clash/通用订阅。</li>
            <li><strong>Android：</strong>适配 Clash Verge Android、v2rayNG 与 Sing-box 客户端。</li>
            <li><strong>iOS：</strong>支持 Shadowrocket（小火箭）、Loon、Surge 与 Quantumult X，提供二维码一键扫码导入。</li>
            <li><strong>macOS：</strong>支持 Clash Verge Rev Mac 版及 Surge。</li>
          </ul>
        </section>

        <!-- Section 9: AI 与流媒体支持 -->
        <section>
          <h2>五、AI 工具与 4K 流媒体解锁实测</h2>
          <p>
            现代网络代理的核心诉求之一是跨国智能服务与高清流媒体。实验室实测结果如下：
          </p>
          <div class="not-prose grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 bg-indigo-50/60 rounded-xl border border-indigo-100 text-xs">
              <strong class="text-indigo-950 font-bold block mb-2">🤖 AI 平台实测支持：</strong>
              <div class="flex flex-wrap gap-1.5">
                {airport.aiSupport?.map(ai => (
                  <span class="bg-white text-indigo-800 px-2 py-0.5 rounded shadow-2xs font-medium border border-indigo-200">
                    ✓ {ai}
                  </span>
                ))}
              </div>
            </div>
            <div class="p-4 bg-rose-50/60 rounded-xl border border-rose-100 text-xs">
              <strong class="text-rose-950 font-bold block mb-2">📺 流媒体解锁实测：</strong>
              <div class="flex flex-wrap gap-1.5">
                {airport.streamingSupport?.map(st => (
                  <span class="bg-white text-rose-800 px-2 py-0.5 rounded shadow-2xs font-medium border border-rose-200">
                    🎬 {st}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- Section 10 & 11: 优缺点分析 -->
        <section>
          <h2>六、客观优缺点深度剖析</h2>
          <div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-4 my-4 text-xs">
            <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-200">
              <h3 class="font-bold text-emerald-950 text-sm mb-2">✓ 核心优势</h3>
              <ul class="list-disc list-inside space-y-1.5 text-emerald-900">
                {airport.advantages.map(a => <li>{a}</li>)}
              </ul>
            </div>
            <div class="p-4 bg-amber-50 rounded-xl border border-amber-200">
              <h3 class="font-bold text-amber-950 text-sm mb-2">⚠ 潜在不足与门槛</h3>
              <ul class="list-disc list-inside space-y-1.5 text-amber-900">
                {airport.disadvantages.map(d => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <!-- Section 12: 适合人群 -->
        <section>
          <h2>七、适合人群画像</h2>
          <p>
            综合资费与线路属性，{airport.name} 最适合以下使用群体：
          </p>
          <ul>
            {airport.suitableFor.map(s => <li><strong>{s}</strong></li>)}
          </ul>
        </section>

        <!-- Section 13: 购买前注意事项 -->
        <section>
          <h2>八、订购前 3 大关键注意事项</h2>
          <ol>
            <li><strong>优先选用月付体验：</strong>无论任何机场，初次订购都建议从最短周期（月付或季付）开始，确保在你自己当前网络宽带下体验满意。</li>
            <li><strong>核实在线设备限制：</strong>该服务商限制为 <code>{airport.deviceLimit || '尚未核实'}</code>，请勿在过多设备上并发使用，以免触发防盗刷风控限速。</li>
            <li><strong>避开特殊敏感期批量下载：</strong>请合理合规使用网络加速服务，勿在高峰期滥用 BT 种子下载侵权资源。</li>
          </ol>
        </section>

        <!-- Section 14: 常见问题 FAQ -->
        <section>
          <h2>九、{airport.name} 常见问答</h2>
          <div class="not-prose space-y-3 my-4 text-xs">
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
              <strong class="text-slate-900 block text-sm">问：{airport.name} 是否提供退款保障？</strong>
              <p class="text-slate-600 mt-1">答：代理机场通常属于虚拟数字流量服务，开通并消耗流量后一般不支持无理由退款。因此我们强烈建议先订购月付套餐进行本地实测。</p>
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
              <strong class="text-slate-900 block text-sm">问：节点连接后无法访问 ChatGPT 怎么办？</strong>
              <p class="text-slate-600 mt-1">答：OpenAI 对部分机房 IP 有风控。请在客户端节点列表中切换为标注为“原生”或“ISP”的指定美区/日区节点，并开启客户端的 TUN 虚拟网卡模式。</p>
            </div>
          </div>
        </section>

        <!-- Section 16 & 17: 数据来源与核验声明 -->
        <section class="border-t border-slate-200 pt-6 text-xs text-slate-500">
          <p><strong>数据来源披露：</strong>{airport.sources.join('；')}</p>
          <p class="mt-1"><strong>最后核验更新：</strong>{airport.lastVerified}。网络服务商可能会不定期调整资费与线路，本站将持续跟进探针监测并在第一时间更新档案。</p>
        </section>

      </div>

      <!-- Right Sidebar (1 col) -->
      <aside class="space-y-6">
        
        <!-- Score Box Card -->
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs text-center">
          <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">实验室综合评级</div>
          <div class="text-4xl font-black text-brand-600 font-mono my-2">
            {airport.metrics.overallScore.toFixed(1)}<span class="text-xs font-normal text-slate-400">/10</span>
          </div>
          
          <div class="space-y-2 text-xs text-left pt-4 border-t border-slate-100">
            <div class="flex justify-between">
              <span class="text-slate-500">全天稳定性：</span>
              <span class="font-bold text-slate-800 font-mono">{airport.metrics.stabilityScore} / 10</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">晚高峰抗拥堵：</span>
              <span class="font-bold text-slate-800 font-mono">{airport.metrics.peakPerformanceScore} / 10</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">价格性价比：</span>
              <span class="font-bold text-slate-800 font-mono">{airport.metrics.valueScore} / 10</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">工单响应支持：</span>
              <span class="font-bold text-slate-800 font-mono">{airport.metrics.supportScore} / 10</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 space-y-2">
            {airport.affiliateUrl && (
              <a
                href={airport.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="block w-full py-2.5 rounded-lg bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 transition-colors shadow-xs"
              >
                🚀 直达 {airport.name} 官网选购 →
              </a>
            )}
            <a
              href={`/compare/?a=${airport.id}`}
              class="block w-full py-2 rounded-lg bg-brand-50 text-brand-700 font-semibold text-xs border border-brand-200 hover:bg-brand-100 transition-colors"
            >
              加入横向参数对比
            </a>
            <a
              href={`/airport/${airport.slug}/`}
              class="block w-full py-2 rounded-lg bg-slate-100 text-slate-700 font-medium text-xs hover:bg-slate-200 transition-colors"
            >
              查看官方参数档案
            </a>
          </div>
        </div>

        <!-- Section 15: 相关机场横向比较 -->
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs">
          <h3 class="text-sm font-bold text-slate-900 mb-3">相关机场对比推荐</h3>
          <div class="space-y-3 text-xs">
            {otherAirports.map(other => (
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-100 flex items-center justify-between">
                <div>
                  <a href={`/review/${other.slug}/`} class="font-bold text-slate-800 hover:text-brand-600 block">
                    {other.name}
                  </a>
                  <span class="text-[11px] text-slate-500">{other.lineType} · ¥{other.startingPrice}起</span>
                </div>
                <a href={`/compare/?a=${airport.id}&b=${other.id}`} class="text-brand-600 font-semibold hover:underline">
                  比对 →
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Guides Links -->
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs">
          <h3 class="text-sm font-bold text-slate-900 mb-3">新手配置指南</h3>
          <ul class="space-y-2 text-xs">
            <li><a href="/guides/windows/" class="text-brand-600 hover:underline">→ Windows Clash Verge 配置教程</a></li>
            <li><a href="/guides/android/" class="text-brand-600 hover:underline">→ Android 手机客户端配置教程</a></li>
            <li><a href="/guides/ios/" class="text-brand-600 hover:underline">→ iOS 小火箭 Shadowrocket 教程</a></li>
            <li><a href="/guides/macos/" class="text-brand-600 hover:underline">→ macOS 苹果电脑代理设置</a></li>
          </ul>
        </div>

      </aside>

    </div>

  </article>
</BaseLayout>
