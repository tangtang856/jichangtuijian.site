---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airports, type Airport } from '../../data/airports';

export function getStaticPaths() {
  return airports.map((airport, index) => {
    const prevAirport = index > 0 ? airports[index - 1] : airports[airports.length - 1];
    const nextAirport = index < airports.length - 1 ? airports[index + 1] : airports[0];
    return {
      params: { slug: airport.slug },
      props: {
        airport,
        prevAirport: { name: prevAirport.name, slug: prevAirport.slug, startingPrice: prevAirport.startingPrice, lineType: prevAirport.lineType },
        nextAirport: { name: nextAirport.name, slug: nextAirport.slug, startingPrice: nextAirport.startingPrice, lineType: nextAirport.lineType }
      },
    };
  });
}

export interface Props {
  airport: Airport;
  prevAirport: { name: string; slug: string; startingPrice?: number; lineType: string };
  nextAirport: { name: string; slug: string; startingPrice?: number; lineType: string };
}

const { airport, prevAirport, nextAirport } = Astro.props;

const title = `${airport.name}怎么样？2026节点线路、价格套餐与配置参数档案 | 机场推荐网`;
const description = `${airport.name}详细参数与资费档案。涵盖${airport.lineType}线路规格、国内BGP入口、起步价格¥${airport.startingPrice}、支持协议、AI与流媒体解锁能力。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场推荐', url: '/recommend/' },
  { name: airport.name }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: airport.name,
  description: airport.description,
  brand: {
    '@type': 'Brand',
    name: airport.name
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: airport.currency || 'CNY',
    lowPrice: airport.startingPrice,
    offerCount: airport.plans.length
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={`https://jichangtuijian.site/airport/${airport.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- ==================== PREV / NEXT BRAND TOP NAVIGATION BAR ==================== -->
    <nav aria-label="品牌快速切换" class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-8 p-3.5 rounded-2xl bg-white border border-slate-200 text-xs shadow-2xs">
      <a
        href={`/airport/${prevAirport.slug}/`}
        class="text-slate-600 hover:text-blue-600 font-medium flex items-center gap-1.5 transition-colors group"
      >
        <span class="text-blue-600 font-bold group-hover:-translate-x-0.5 transition-transform">←</span>
        <span>上一个品牌：<strong>{prevAirport.name}</strong> (¥{prevAirport.startingPrice}起 · {prevAirport.lineType})</span>
      </a>

      <div class="hidden md:flex items-center gap-2 text-slate-400 font-mono text-[11px]">
        <span>BRAND DIRECTORY // 27 家服务商已核验</span>
      </div>

      <a
        href={`/airport/${nextAirport.slug}/`}
        class="text-slate-600 hover:text-blue-600 font-medium flex items-center gap-1.5 transition-colors group"
      >
        <span>下一个品牌：<strong>{nextAirport.name}</strong> (¥{nextAirport.startingPrice}起 · {nextAirport.lineType})</span>
        <span class="text-blue-600 font-bold group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </nav>

    <!-- Top Header Card -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 mb-10 shadow-sm relative overflow-hidden">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-slate-100">
        <div class="space-y-3 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold font-mono border border-blue-200">
              {airport.badge || airport.lineType}
            </span>
            <span class="text-xs text-slate-500 font-mono">
              稳定运营 {2026 - airport.establishedYear} 年+ (始于 {airport.establishedYear})
            </span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
              ✓ 真实链路核验通过
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
            {airport.name} 资料档案与网络配置手册
          </h1>
          <p class="text-sm text-slate-500 leading-relaxed font-medium">{airport.tagline}</p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap gap-2.5 shrink-0 items-center">
          {airport.affiliateUrl && (
            <a
              href={airport.affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md shadow-blue-500/20 hover:shadow-lg transition-all flex items-center gap-1.5 transform hover:-translate-y-0.5"
            >
              <span>🚀</span>
              <span>直达 {airport.name} 官网</span>
            </a>
          )}
          <a
            href={`/review/${airport.slug}/`}
            class="px-4 py-3 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-slate-800 shadow-xs transition-colors"
          >
            独立测速评测报告 →
          </a>
          <a
            href={`/compare/?a=${airport.id}`}
            class="px-4 py-3 rounded-xl bg-slate-100 text-slate-700 font-semibold text-xs hover:bg-slate-200 transition-colors"
          >
            ⚖️ 加入参数比对
          </a>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-xs">
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
          <span class="text-slate-500 block mb-1">最低套餐门槛</span>
          <span class="text-xl font-bold text-emerald-600 font-mono">¥{airport.startingPrice} 起/月</span>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
          <span class="text-slate-500 block mb-1">核心物理线路</span>
          <span class="text-sm font-bold text-slate-800">{airport.lineType}</span>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
          <span class="text-slate-500 block mb-1">国内 BGP 入口</span>
          <span class="text-xs font-medium text-slate-800">{airport.entryBgp}</span>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
          <span class="text-slate-500 block mb-1">并发设备限制</span>
          <span class="text-xs font-mono font-medium text-slate-800">{airport.deviceLimit || '未严格限制'}</span>
        </div>
      </div>
    </div>

    <!-- In-depth Architecture & Overview (深度专业背景分析) -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 mb-10 shadow-sm space-y-6">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          INFRASTRUCTURE & ARCHITECTURE
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900">品牌技术背景与骨干网络定位</h2>
      </div>

      <p class="text-sm text-slate-700 leading-relaxed">
        {airport.description}
      </p>

      {airport.networkArchitecture && (
        <div class="p-5 rounded-2xl bg-blue-50/50 border border-blue-100 text-xs text-slate-700 space-y-2">
          <strong class="text-blue-900 font-bold block text-sm">🌐 拓扑架构与链路调度技术细节：</strong>
          <p class="leading-relaxed">{airport.networkArchitecture}</p>
        </div>
      )}
    </div>

    <!-- Official Plans Breakdown -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 mb-10 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-slate-100 gap-2">
        <div>
          <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
            <span>💳</span> 公开价格方案与每 GB 成本测算
          </h2>
          <p class="text-xs text-slate-500 mt-1">杜绝数字游戏，折算真实每 GB 可用流量成本</p>
        </div>
        <span class="text-xs font-mono text-slate-400">核验有效：2026 年</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase font-semibold font-mono">
              <th class="py-3.5 px-4">套餐方案名称</th>
              <th class="py-3.5 px-4">计费周期</th>
              <th class="py-3.5 px-4">包含可用流量</th>
              <th class="py-3.5 px-4 text-emerald-700 font-bold">每 GB 折算单价</th>
              <th class="py-3.5 px-4">主要服务权益</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {airport.plans.map((p) => {
              const unitCost = (p.price / p.trafficGB).toFixed(3);
              return (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-3.5 px-4 font-bold text-slate-900">{p.name}</td>
                  <td class="py-3.5 px-4 font-mono font-medium">¥{p.price} / {p.period === 'quarter' ? '季付' : p.period === 'year' ? '年付' : p.period === 'one-time' ? '一次性不限时' : '月付'}</td>
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-800">{p.trafficGB} GB</td>
                  <td class="py-3.5 px-4 font-mono font-bold text-emerald-600">¥{unitCost} / GB</td>
                  <td class="py-3.5 px-4 text-slate-600">
                    {p.features?.join(' · ') || '全专线高速节点'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Technical Specs & Node Network (2 cols) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      
      <!-- Left: Specs -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm text-xs space-y-4">
        <h3 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
          <span>⚙️</span> 技术参数与协议支持
        </h3>
        
        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">支持底层网络协议：</span>
          <div class="flex flex-wrap gap-1.5">
            {airport.protocols.map(pt => (
              <span class="bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-mono font-medium">{pt}</span>
            ))}
          </div>
        </div>

        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">在线设备并发限制：</span>
          <span class="text-slate-800 font-medium">{airport.deviceLimit || '尚未核实限制'}</span>
        </div>

        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">AI 智能工具解锁实测：</span>
          <div class="flex flex-wrap gap-1.5">
            {airport.aiSupport?.map(ai => (
              <span class="bg-purple-50 text-purple-700 px-2.5 py-1 rounded-lg border border-purple-200 font-medium">✓ {ai}</span>
            ))}
          </div>
          {airport.aiUnblockAnalysis && (
            <p class="text-[11px] text-slate-500 mt-2 leading-relaxed bg-purple-50/40 p-2.5 rounded-lg border border-purple-100">
              {airport.aiUnblockAnalysis}
            </p>
          )}
        </div>

        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">4K 流媒体跨区解锁实测：</span>
          <div class="flex flex-wrap gap-1.5">
            {airport.streamingSupport?.map(st => (
              <span class="bg-rose-50 text-rose-700 px-2.5 py-1 rounded-lg border border-rose-200 font-medium">🎬 {st}</span>
            ))}
          </div>
          {airport.streamingAnalysis && (
            <p class="text-[11px] text-slate-500 mt-2 leading-relaxed bg-rose-50/40 p-2.5 rounded-lg border border-rose-100">
              {airport.streamingAnalysis}
            </p>
          )}
        </div>
      </div>

      <!-- Right: Regions & Audience -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm text-xs space-y-4">
        <h3 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
          <span>🌍</span> 节点分布与契合人群
        </h3>
        
        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">覆盖国家与节点地区：</span>
          <div class="flex flex-wrap gap-1.5">
            {airport.regions.map(rg => (
              <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-lg border border-blue-200 font-medium">{rg}</span>
            ))}
          </div>
        </div>

        <div>
          <span class="text-slate-500 font-semibold block mb-1.5">建议首选人群：</span>
          <ul class="space-y-1.5 text-slate-700">
            {airport.suitableFor.map(s => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-2 border-t border-slate-100">
          <span class="text-slate-500 font-semibold block mb-1.5">数据核验与可信记录：</span>
          <ul class="space-y-1 text-slate-400 text-[11px]">
            {airport.sources.map(src => (
              <li>• {src}</li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <!-- Pros & Cons Analysis -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 mb-10 shadow-sm">
      <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span>⚖️</span> 客观优缺点辩证分析
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        <div class="p-5 bg-emerald-50/50 rounded-2xl border border-emerald-100 space-y-2">
          <span class="font-bold text-emerald-900 text-sm block">突出核心优势：</span>
          <ul class="space-y-1.5 text-emerald-800">
            {airport.advantages.map(a => (
              <li class="flex items-start gap-1.5">
                <span class="font-bold shrink-0">✓</span>
                <span class="leading-relaxed">{a}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="p-5 bg-amber-50/50 rounded-2xl border border-amber-100 space-y-2">
          <span class="font-bold text-amber-900 text-sm block">购买前注意事项与门槛：</span>
          <ul class="space-y-1.5 text-amber-800">
            {airport.disadvantages.map(d => (
              <li class="flex items-start gap-1.5">
                <span class="font-bold shrink-0">!</span>
                <span class="leading-relaxed">{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Brand Specific FAQs -->
    {airport.faqs && airport.faqs.length > 0 && (
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 mb-10 shadow-sm">
        <div class="mb-6">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>❓</span> 针对 {airport.name} 的常见疑问与选购答疑
          </h3>
          <p class="text-xs text-slate-500 mt-1">解答用户在订购、配置及日常使用中的常见问题</p>
        </div>

        <div class="space-y-3">
          {airport.faqs.map((faq, idx) => (
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs space-y-1.5">
              <div class="font-bold text-slate-900 flex items-center gap-2 text-sm">
                <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-[10px] font-mono shrink-0 font-bold">
                  Q{idx + 1}
                </span>
                <span>{faq.q}</span>
              </div>
              <p class="text-slate-600 leading-relaxed pl-7">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom Navigation Bar -->
    <nav aria-label="底部品牌翻页" class="p-4 rounded-2xl bg-white border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs shadow-2xs">
      <a
        href={`/airport/${prevAirport.slug}/`}
        class="text-slate-700 hover:text-blue-600 font-medium flex items-center gap-1.5"
      >
        <span>←</span>
        <span>上一个品牌：<strong>{prevAirport.name}</strong></span>
      </a>

      <div class="flex items-center gap-3">
        <a href="/recommend/" class="text-blue-600 font-semibold hover:underline">返回机场推荐总览</a>
        <span class="text-slate-300">|</span>
        <a href="/compare/" class="text-blue-600 font-semibold hover:underline">进入横向比对工具</a>
      </div>

      <a
        href={`/airport/${nextAirport.slug}/`}
        class="text-slate-700 hover:text-blue-600 font-medium flex items-center gap-1.5"
      >
        <span>下一个品牌：<strong>{nextAirport.name}</strong></span>
        <span>→</span>
      </a>
    </nav>

  </div>
</BaseLayout>
