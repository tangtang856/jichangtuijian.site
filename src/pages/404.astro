---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '页面未找到 (404) | 机场推荐网';
const description = '您访问的页面不存在或已被移动。请返回首页或浏览核心机场推荐与排行榜。';
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="max-w-md mx-auto space-y-4">
      <div class="text-7xl font-extrabold text-brand-600 font-mono">404</div>
      <h1 class="text-2xl font-bold text-slate-900">抱歉，您访问的页面不存在</h1>
      <p class="text-xs text-slate-500 leading-relaxed">
        可能是网址输入有误，或者该文章已更新并调整了访问路径。您可以直接通过下方入口快速返回：
      </p>

      <div class="pt-4 flex flex-wrap justify-center gap-3 text-xs">
        <a href="/" class="px-4 py-2 rounded-lg bg-brand-600 text-white font-semibold hover:bg-brand-700 shadow-xs">
          返回网站首页
        </a>
        <a href="/recommend/" class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-medium hover:bg-slate-200">
          机场推荐专题
        </a>
        <a href="/ranking/overall/" class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-medium hover:bg-slate-200">
          综合排行榜
        </a>
        <a href="/guides/" class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-medium hover:bg-slate-200">
          客户端教程中心
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
